# Jarvis Phase 3+
# Required — get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
OPENROUTER_MODEL=openai/gpt-4o-mini
PORT=3000

# LLM provider switch: openrouter (default) or gemini
LLM_PROVIDER=openrouter
# Required when LLM_PROVIDER=gemini
GEMINISTUDIO_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Neo4j (Phase 3) — used by BOTH the neo4j compose service and the backend.
# Form: <user>/<password>. The neo4j image refuses passwords shorter than 8
# chars, and the backend parses this same variable (see README §3).
NEO4J_AUTH=neo4j/jarvis-dev-password

# Host user the containers run as — compose reads these from .env so plain
# `docker compose up` keeps ./data host-owned with NO exported env vars.
# Set them to your UID/GID (`id -u` / `id -g`), usually 1000:1000.
USER_ID=1000
GROUP_ID=1000